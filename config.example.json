{
  "app_id": "com.example.Surface",
  "workspace": "ops",
  "legacy_workspace": "ops-old",
  "unit_root": "/path/to/units",
  "launch": ["example-launcher", "--unit", "{unit}", "--profile", "{profile}"],
  "keys": {"inspect": 18, "resume": 1, "activate": 37, "mode": 25, "recall": 103},
  "width": 240,
  "columns": [
    ["02-beta", "04-beta", "05-beta", "07-beta"],
    ["01-alpha", "03-alpha", "06-alpha"]
  ],
  "targets": [
    {"title": "01-alpha", "unit": "unit-01", "profile": "profile-01", "final": "pointer"},
    {"title": "02-beta", "unit": "unit-02", "profile": "profile-02", "final": "key-inspect"},
    {"title": "03-alpha", "unit": "unit-03", "profile": "profile-03", "final": "pointer"},
    {"title": "04-beta", "unit": "unit-04", "profile": "profile-04", "final": "key-inspect"},
    {"title": "05-beta", "unit": "unit-05", "profile": "profile-05", "final": "key-inspect"},
    {"title": "06-alpha", "unit": "unit-06", "profile": "profile-06", "final": "pointer"},
    {"title": "07-beta", "unit": "unit-07", "profile": "profile-07", "final": "key-inspect"}
  ]
}
